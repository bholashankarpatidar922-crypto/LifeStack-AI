# =====================================================================
# LifeStack Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# For local zero-credential execution, defaults work out-of-the-box!
# =====================================================================

# App Config
BRAND_NAME=LifeStack
ENVIRONMENT=development
DEBUG=True
PORT=8000
FRONTEND_PORT=5173
SECRET_KEY=lifestack_super_secret_dev_key_change_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Use sqlite+aiosqlite for zero-install local dev or postgresql+asyncpg for pgvector production
DATABASE_URL=sqlite+aiosqlite:///./lifestack.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lifestack

# Vector Store
# Options: mock (numpy/cosine in-memory/sqlite) | pgvector
VECTOR_BACKEND=mock
EMBEDDING_DIMENSION=768

# GenAI Providers (Set one or use mock adapter)
# LLM_PROVIDER options: mock | gemini | claude | openai
LLM_PROVIDER=mock
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Google OAuth (Leave empty for local mock authentication)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloud & Storage (Local fallback paths)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage
GCS_BUCKET_NAME=

# Push Notifications (FCM - Optional)
FCM_SERVER_KEY=
